{
  "name": "vscode-empty-commit-extension",
  "displayName": "Empty Commit",
  "description": "One-click initialization of repositories with empty commits. Perfect for post-fork setup.",
  "version": "0.1.0",
  "author": "Ed-bb",
  "license": "MIT",
  "engines": {
    "vscode": ">=1.75.0"
  },
  "categories": ["SCM Providers"],
  "keywords": ["git", "empty commit", "initialize", "repository", "fork"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ed-bb/vscode-empty-commit-extension"
  },
  "activationEvents": [
    "onCommand:empty-commit.quick",
    "onCommand:empty-commit.custom",
    "onCommand:empty-commit.init"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "empty-commit.quick",
        "title": "Quick Empty Commit",
        "category": "Empty Commit",
        "description": "Create an empty commit instantly (auto-initializes repo if needed)"
      },
      {
        "command": "empty-commit.custom",
        "title": "Create Empty Commit with Message",
        "category": "Empty Commit",
        "description": "Create an empty commit with a custom message"
      },
      {
        "command": "empty-commit.init",
        "title": "Initialize Repository",
        "category": "Empty Commit",
        "description": "Initialize repository with optional git config and create first commit"
      }
    ],
    "keybindings": [
      {
        "command": "empty-commit.quick",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "explorerViewletFocus",
        "description": "Quick empty commit (fastest way to initialize)"
      },
      {
        "command": "empty-commit.custom",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "explorerViewletFocus",
        "description": "Create empty commit with custom message"
      },
      {
        "command": "empty-commit.init",
        "key": "ctrl+shift+alt+e",
        "mac": "cmd+shift+alt+e",
        "when": "explorerViewletFocus",
        "description": "Initialize repository with git config"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "typescript": "^4.7.0"
  }
}
